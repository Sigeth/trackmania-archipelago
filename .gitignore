# Packaging output (plugin + apworld)
*.op
*.apworld
/build/
/dist/

# AngelScript checker (tools/as): build tree + generated stub. check.ps1 now puts
# both under %LOCALAPPDATA%\op-asrun-cache (outside the deployed plugin folder);
# these paths still catch in-tree CI / manual `cmake -B tools/as/build` runs.
tools/as/build/
tools/as/generated/
*.obj

# Python
__pycache__/
*.py[cod]

# semantic-release (CI installs these ad hoc)
node_modules/
package-lock.json

# Editor / OS
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store

# Local, non-committed config
*.local.toml

# Extracted native game sound files (Nadeo's copyrighted audio, ripped from the
# Turbo packs by the player -- see assets/README.md). Never commit these.
/assets/*.wav
/assets/*.ogg
