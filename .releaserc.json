{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "python tools/bump_version.py ${nextRelease.version} && bash tools/package.sh"
    }],
    ["@semantic-release/git", {
      "assets": [
        "CHANGELOG.md",
        "info.toml",
        "apworld/trackmania_turbo/archipelago.json",
        "apworld/trackmania_turbo/__init__.py"
      ],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "dist/Archipelago.op", "label": "Archipelago.op (Openplanet plugin)" },
        { "path": "dist/trackmania_turbo.apworld", "label": "trackmania_turbo.apworld (Archipelago world)" }
      ]
    }]
  ]
}
